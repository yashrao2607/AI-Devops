# ==============================================================================
# DeploySafe — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (Primary LLM & Embedding provider)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Groq Cloud API Key (Fast Fallback LLM provider)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# GitHub Personal Access Token (for Phase 2+ repository fetching & actions)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# ------------------------------------------------------------------------------
# 2. Model & Provider Selection
# ------------------------------------------------------------------------------
# Primary LLM provider: 'gemini' or 'groq'
PRIMARY_LLM_PROVIDER=gemini

# Fallback LLM provider: 'groq' or 'gemini'
FALLBACK_LLM_PROVIDER=groq

# Gemini Model Name (Recommended: gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Groq Model Name (Recommended: llama-3.3-70b-versatile or mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. Storage & Database
# ------------------------------------------------------------------------------
# SQLite Database connection URL
DATABASE_URL=sqlite:///./deploysafe.db

# Chroma Vector Database storage path (for Phase 2+ RAG)
CHROMA_PATH=./chroma_db

# ------------------------------------------------------------------------------
# 4. Application Runtime & Observability
# ------------------------------------------------------------------------------
# Environment: 'development', 'staging', 'production'
APP_ENV=development

# Logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Backend API server port
API_PORT=8000
API_HOST=0.0.0.0

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Phase 2 RAG & Vector Storage Configuration
# ------------------------------------------------------------------------------
# Embedding provider: 'gemini' (uses text-embedding-004) or 'local' (deterministic fallback)
EMBEDDING_PROVIDER=gemini

# Chroma collection prefix
CHROMA_COLLECTION_PREFIX=deploysafe_repo

# Maximum file size allowed for indexing (in Megabytes)
MAX_FILE_SIZE_MB=10

# Maximum repository size allowed for ingestion (in Megabytes)
MAX_REPOSITORY_SIZE_MB=200

# Maximum file count allowed for ingestion
MAX_FILE_COUNT=2000

# Default top-k retrieved evidence chunks
TOP_K=5
