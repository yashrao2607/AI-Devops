# DeploySafe - Git Ignore Rules

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & Vector Stores
*.db
*.sqlite
*.sqlite3
chroma_db/
chroma_data/
cloned_repos/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
